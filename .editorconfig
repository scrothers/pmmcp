# EditorConfig (https://editorconfig.org) — keeps editors consistent with
# gofmt and the repo's YAML/Markdown conventions.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt owns Go formatting: tabs, never spaces.
[*.go]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

# Markdown: trailing double-space is a hard line break — never strip it.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.proto]
indent_style = space
indent_size = 2
