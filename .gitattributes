# Normalize line endings: LF in the repository, LF on checkout everywhere.
# Windows contributors get correct behavior without core.autocrlf guesswork —
# this matters for golden files and byte-exact test fixtures.
* text=auto eol=lf

# Windows-native scripts are the one place CRLF is correct.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never mangle binaries.
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Generated code: keep language stats honest and collapse it in PR diffs.
internal/api/gen/** linguist-generated=true
go.sum linguist-generated=true
